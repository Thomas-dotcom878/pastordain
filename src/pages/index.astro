---
import Layout from '../layouts/Layout.astro';
import ThumbGrid from '../components/ThumbGrid.astro';
import { thisWeek } from '../data/this-week';
import { playlists, singleVideos } from '../data/videos';
---

<Layout>
	<a
		href="#content"
		class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-white focus:p-2"
	>Skip to content</a>

	<main id="content" class="overflow-x-hidden pb-14">
		<!-- ===== Welcome ===== -->
		<header class="mx-auto max-w-[1200px] px-5 pt-7 pb-4 text-center sm:px-[29px]">
			<h1 class="mb-2.5 font-heading text-[25px] leading-[1.3] font-semibold text-black md:text-[41px]">
				Pastor Dain Spore and the Chicken Skin Bible!
			</h1>
			<p class="mb-5 text-[20px] leading-[1.2] text-black md:text-[24px]">
				The great truths of the Bible give me chicken skin: goosebumps, that is!<br />
				You are invited to join me as we look at great moments of chicken skin in God’s amazing Word.&nbsp;<strong>– Dain</strong>
			</p>
		</header>

		<!-- ===== This week's study ===== -->
		<section class="mx-auto max-w-[1200px] px-5">
			<a href={thisWeek.videoUrl} class="mx-auto block max-w-[1024px] transition-opacity hover:opacity-90">
				<img
					src={thisWeek.image}
					alt={`Watch: ${thisWeek.title}`}
					width="1024"
					height="577"
					class="h-auto w-full"
					fetchpriority="high"
				/>
			</a>

			<p class="mt-2.5 mb-6 text-center text-[20px] leading-[1.2] font-bold text-black md:text-[24px]">
				Click image to watch
			</p>

			<h2 class="text-center font-heading text-[38px] leading-[1.3] font-medium text-study sm:text-[50px] md:text-[63px]">
				{thisWeek.title}
			</h2>

			<p class="mt-[17px] mb-2 pt-2 text-center text-[20px] leading-[1.2] text-black">
				{thisWeek.posted}
			</p>

			<div class="text-[20px] md:text-[24px]">
				<p class="mb-3 px-4 text-center leading-[1.4] md:px-[57px]">{thisWeek.greeting}</p>
				{thisWeek.paragraphs.map((p) => <p class="mb-3 leading-[1.2]">{p}</p>)}
				<p class="mb-3 px-4 text-center leading-[1.4] md:px-[57px]">
					{thisWeek.signoff.map((line, i) => (
						<>
							{i > 0 && <br />}
							{line}
						</>
					))}
				</p>
			</div>
		</section>

		<p class="mx-auto max-w-[1200px] px-5 pt-3 pb-10 text-center text-[20px] leading-[1.2] font-bold text-black md:text-[24px]">
			Dain’s Tuesday Night Bible Studies start a bit after 7:00 with a couple of worship songs.
		</p>

		<!-- ===== Anchor House ===== -->
		<section class="mx-auto max-w-[1200px] px-5 text-center text-[18px] leading-[1.45] text-black md:text-[20px]">
			<a
				href="https://youtu.be/bKP526JvzHE?si=CvS7JXRtagW-bvlj"
				class="mx-auto block max-w-[797px] transition-opacity hover:opacity-90"
			>
				<img
					src="/images/anchor-house.webp"
					alt="Watch the KCF Anchor House Bible school video"
					width="1200"
					height="675"
					loading="lazy"
					class="h-auto w-full"
				/>
			</a>
			<p class="mt-3 font-bold">The Anchor House video: Tap or click the image to watch.</p>
			<p class="mt-3">The above image links to a fun video featuring the KCF Anchor House Bible school kids.</p>
			<p class="mb-[38px]">The button takes you to an information and application page:</p>
			<a
				href="https://www.kauaichristian.org/the-anchor-house"
				class="inline-block rounded-[30px] border border-[#333] bg-anchor px-6 py-3 text-[24px] leading-none font-extralight tracking-[3px] text-white transition-opacity hover:opacity-85"
			>ANCHOR HOUSE</a>

			<div class="mx-auto mt-[25px] mb-[35px] w-1/3 min-w-[200px] border-t-[7px] border-dotted border-body"></div>
		</section>

		<!-- ===== Playlists ===== -->
		<section class="mb-14">
			<h2 class="mb-5 text-center font-heading text-[34px] leading-[1.3] font-semibold text-black md:text-[42px]">
				PLAYLISTS:
			</h2>
			<p class="mb-2.5 px-5 text-center text-[20px] leading-[1.45] font-bold text-black">
				Tap or click any image to watch each playlist.
			</p>
			<ThumbGrid items={playlists} label="Playlist" />
		</section>

		<!-- ===== Single videos ===== -->
		<section>
			<h2 class="mb-5 text-center font-heading text-[34px] leading-[1.3] font-semibold text-black md:text-[42px]">
				SINGLE VIDEOS:
			</h2>
			<ThumbGrid items={singleVideos} label="Video" />
		</section>
	</main>

	<!-- ===== Scroll to top button ===== -->
	<a
		href="#"
		id="scroll-top"
		aria-label="Scroll to top"
		class="pointer-events-none fixed right-[30px] bottom-[30px] flex size-[65px] items-center justify-center rounded-full bg-scrolltop opacity-0 transition-opacity duration-300"
	>
		<svg width="26" height="16" viewBox="0 0 26 16" aria-hidden="true">
			<path d="M2 14 L13 3 L24 14" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</a>

	<script>
		const btn = document.getElementById('scroll-top');
		const toggle = () => {
			const show = window.scrollY > 300;
			btn?.classList.toggle('opacity-0', !show);
			btn?.classList.toggle('pointer-events-none', !show);
		};
		window.addEventListener('scroll', toggle, { passive: true });
		toggle();
	</script>
</Layout>
