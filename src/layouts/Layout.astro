---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'pastordain.com',
	description = 'Pastor Dain Spore and the Chicken Skin Bible — Bible study videos and playlists.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-white font-sans text-[17px] leading-[1.7] text-body antialiased">
		<slot />
	</body>
</html>
